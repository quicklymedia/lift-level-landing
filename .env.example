# --- Lead delivery (server-side only, never exposed to the browser) ---
# Primary: GHL Inbound Webhook. Paste the workflow webhook URL from GoHighLevel.
GHL_WEBHOOK_URL=

# Fallback: GHL API v2 (used only if the webhook is missing or fails).
GHL_API_TOKEN=
GHL_LOCATION_ID=

# --- Public config ---
# Tracking phone number, digits only. Placeholder until the call-tracking number arrives.
NEXT_PUBLIC_PHONE_NUMBER=4045007450

# Google Tag Manager container id (GTM-XXXXXXX). GTM is not injected if empty.
NEXT_PUBLIC_GTM_ID=

# Google Ads tag (gtag.js). Defaults to AW-18371630260 in code if empty.
NEXT_PUBLIC_GOOGLE_ADS_ID=
